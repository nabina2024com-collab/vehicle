  const handleFileUpload = (e) => {
    const file = e.target.files?.[0];
    if (!file) return;

    const isImage = file.type.startsWith("image/");
    const isVideo = file.type.startsWith("video/");

    if (!isImage && !isVideo) {
      setError("Please upload an image (JPG, PNG, WebP) or video (MP4, WebM).");
      return;
    }

    const url = URL.createObjectURL(file);
    setFileType(isImage ? "image" : "video");
    setMediaUrl(url);
    setFileName(file.name);
    setResults(null);
    setError(null);
    setZoomLevel(1);
    setPanOffset({ x: 0, y: 0 });
    setSelectedVehicleId(null);
    setSearchQuery("");
  };

  const captureCurrentFrameBase64 = async () => {
    const canvas = hiddenCanvasRef.current || document.createElement("canvas");
    const ctx = canvas.getContext("2d");

    if (fileType === "image") {
      const img = imageRef.current;
      if (!img) throw new Error("Image element not ready");
      if (!img.complete) {
        await new Promise((res) => { img.onload = res; });
      }
      canvas.width = img.naturalWidth || 1920;
      canvas.height = img.naturalHeight || 1080;
      ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
      return canvas.toDataURL("image/jpeg", 0.95);
    } else if (fileType === "video") {
      const vid = videoRef.current;
      if (!vid) throw new Error("Video element not ready");
      if (vid.readyState < 2) {
        await new Promise((res) => { vid.onloadeddata = res; });
      }
      canvas.width = vid.videoWidth || 1280;
      canvas.height = vid.videoHeight || 720;
      ctx.drawImage(vid, 0, 0, canvas.width, canvas.height);
      return canvas.toDataURL("image/jpeg", 0.92);
    }
    throw new Error("No valid media loaded to analyze");
  };

  const analyzeVisualField = async () => {
    if (!mediaUrl) {
      setError("Please upload a picture or video to start analysis.");
      return;
    }

    if (typeof window !== "undefined" && window.innerWidth < 1280) {
      setMobileTab("viewer");
    }

    setIsAnalyzing(true);
    setError(null);
    setAnalysisProgress(10);
    setSelectedVehicleId(null);

    try {
      if (fileType === "video" && videoRef.current && !videoRef.current.paused) {
        videoRef.current.pause();
        setIsVideoPlaying(false);
      }

      setAnalysisProgress(30);
      const base64DataUrl = await captureCurrentFrameBase64();
      const rawBase64 = base64DataUrl.split(",")[1];

      setAnalysisProgress(55);

      const systemInstruction = `You are a high-precision computer vision surveillance intelligence and ANPR (Automatic Number Plate Recognition) engine.
Your task is to scan EVERY INCH of the provided traffic or street scene (foreground, midground, distant lanes, corners, and side streets).
Locate EVERY vehicle and attempt to locate its license / number plate.

For each vehicle:
1. Identify category: car, truck, bus, motorcycle, bicycle, or emergency.
2. Provide subType and color description (e.g., 'Silver Toyota RAV4 SUV', 'White Box Freight Truck', 'Black Delivery Bike').
3. Detect vehicle 2D bounding box normalized to 0-1000 integer coordinates:
   box_2d: [ymin, xmin, ymax, xmax] where 0 is top/left and 1000 is bottom/right.
4. Detect License Plate:
   - plateDetected: boolean (true if the license plate area is visible or partially readable)
   - plateNumber: string (The alphanumeric text on the plate if readable, or "PLATE-VISIBLE" if readable region exists, or "OBSCURED" if hidden/angled/distant)
   - plate_box_2d: [ymin, xmin, ymax, xmax] 0-1000 coordinates of the license plate rectangle if visible, otherwise null.
5. Provide overall traffic density: 'Light', 'Moderate', 'Dense', or 'Gridlock'.`;

      const userPrompt = `Systematically scan every square inch of this image/frame. Detect all vehicles, accurately locate their license / registration number plates, and return their precise normalized [ymin, xmin, ymax, xmax] bounding boxes.`;

      const payload = {
        contents: [
          {
            role: "user",
            parts: [
              { text: userPrompt },
              {
                inlineData: {
                  mimeType: "image/jpeg",
                  data: rawBase64,
                },
              },
            ],
          },
        ],
        systemInstruction: {
          parts: [{ text: systemInstruction }],
        },
        generationConfig: {
          responseMimeType: "application/json",
          responseSchema: {
            type: "OBJECT",
            properties: {
              density: { type: "STRING" },
              summaryNotes: { type: "STRING" },
              vehicles: {
                type: "ARRAY",
                items: {
                  type: "OBJECT",
                  properties: {
                    label: { type: "STRING" },
                    subType: { type: "STRING" },
                    color: { type: "STRING" },
                    confidence: { type: "NUMBER" },
                    box_2d: {
                      type: "ARRAY",
                      items: { type: "INTEGER" },
                    },
                    plateDetected: { type: "BOOLEAN" },
                    plateNumber: { type: "STRING" },
                    plate_box_2d: {
                      type: "ARRAY",
                      items: { type: "INTEGER" },
                    },
                  },
                  required: ["label", "box_2d", "confidence"],
                },
              },
            },
            required: ["vehicles"],
          },
        },
      };

      setAnalysisProgress(75);

      const apiKey = "";
      const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

      const response = await fetch(apiUrl, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });

      if (!response.ok) {
        throw new Error(`Vision API error: ${response.status} ${response.statusText}`);
      }

      const resJson = await response.json();
      const textOutput = resJson.candidates?.[0]?.content?.parts?.[0]?.text;

      if (!textOutput) {
        throw new Error("No structured vehicle data was returned from the vision model.");
      }

      const parsed = JSON.parse(textOutput);
      const rawVehicles = Array.isArray(parsed.vehicles) ? parsed.vehicles : [];

      const mappedBoxes = rawVehicles
        .filter((v) => Array.isArray(v.box_2d) && v.box_2d.length === 4)
        .map((v, idx) => {
          const [ymin, xmin, ymax, xmax] = v.box_2d;
          const top = Math.max(0, Math.min(100, ymin / 10));
          const left = Math.max(0, Math.min(100, xmin / 10));
          const height = Math.max(1, Math.min(100 - top, (ymax - ymin) / 10));
          const width = Math.max(1, Math.min(100 - left, (xmax - xmin) / 10));

          let normType = "car";
          const l = (v.label || "").toLowerCase();
          if (l.includes("truck") || l.includes("semi")) normType = "truck";
          else if (l.includes("bus") || l.includes("van")) normType = "bus";
          else if (l.includes("motorcycle") || l.includes("scooter")) normType = "motorcycle";
          else if (l.includes("bicycle") || l.includes("bike")) normType = "bicycle";
          else if (l.includes("emergency") || l.includes("police")) normType = "emergency";

          let plateBox = null;
          if (Array.isArray(v.plate_box_2d) && v.plate_box_2d.length === 4) {
            const [p_ymin, p_xmin, p_ymax, p_xmax] = v.plate_box_2d;
            plateBox = {
              top: Math.max(0, Math.min(100, p_ymin / 10)),
              left: Math.max(0, Math.min(100, p_xmin / 10)),
              height: Math.max(0.6, Math.min(100, (p_ymax - p_ymin) / 10)),
              width: Math.max(1.2, Math.min(100, (p_xmax - p_xmin) / 10)),
            };
          }

          return {
            id: `veh-${idx + 1}`,
            index: idx + 1,
            type: normType,
            label: v.label || normType,
            subType: v.subType || normType,
            color: v.color || "Standard",
            confidence: v.confidence ? Math.round(v.confidence * 100) : 96,
            plateDetected: Boolean(v.plateDetected || v.plateNumber),
            plateNumber: v.plateNumber || (v.plateDetected ? "LOCATED" : "NOT-VISIBLE"),
            plateBox,
            top,
            left,
            width,
            height,
            centerX: left + width / 2,
            centerY: top + height / 2,
          };
        });


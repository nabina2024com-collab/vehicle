                <pattern id="viewer-grid" width="30" height="30" patternUnits="userSpaceOnUse">
                  <path d="M 30 0 L 0 0 0 30" fill="none" className="stroke-white" strokeWidth="0.5" />
                </pattern>
              </defs>
              <rect width="100%" height="100%" fill="url(#viewer-grid)" />
            </svg>
          </div>

          {!mediaUrl ? (
            <div className="text-center p-8 max-w-md z-10">
              <div className="w-16 h-16 rounded-2xl bg-slate-900 border border-slate-800 flex items-center justify-center mx-auto mb-4 text-slate-500 shadow-inner">
                <Camera className="w-8 h-8" />
              </div>
              <h3 className="text-base font-semibold text-slate-200">Awaiting Visual Media Input</h3>
              <p className="text-xs text-slate-400 mt-1 leading-relaxed">
                Upload any traffic video or picture. The optical engine scans every quadrant to detect vehicles, pinpoint their license plates, and lets you search and focus directly on any target.
              </p>
            </div>
          ) : (
            <div
              className="relative transition-transform duration-200 ease-out"
              style={{
                transform: `translate(${panOffset.x}px, ${panOffset.y}px) scale(${zoomLevel})`,
                transformOrigin: "center center",
              }}
            >
              {/* Media Display Container */}
              <div className="relative inline-block rounded-xl overflow-hidden shadow-2xl border border-slate-800/80 bg-black">
                {fileType === "image" ? (
                  <img
                    ref={imageRef}
                    src={mediaUrl}
                    alt="Inspection Source"
                    className="max-h-[50vh] sm:max-h-[62vh] max-w-[92vw] sm:max-w-[82vw] object-contain block"
                    style={{
                      filter: isAnalyzing ? "brightness(0.65) contrast(1.1)" : "none",
                      transition: "filter 0.3s ease",
                    }}
                  />
                ) : (
                  <video
                    ref={videoRef}
                    src={mediaUrl}
                    onTimeUpdate={handleVideoTimeUpdate}
                    onLoadedMetadata={handleVideoLoadedMetadata}
                    playsInline
                    className="max-h-[50vh] sm:max-h-[62vh] max-w-[92vw] sm:max-w-[82vw] object-contain block"
                    style={{
                      filter: isAnalyzing ? "brightness(0.65) contrast(1.1)" : "none",
                      transition: "filter 0.3s ease",
                    }}
                  />
                )}

                {/* Laser Scanning Animation Bar */}
                {isAnalyzing && (
                  <motion.div
                    className="absolute inset-x-0 h-1 bg-gradient-to-r from-transparent via-sky-400 to-transparent shadow-[0_0_20px_4px_rgba(56,189,248,0.7)] z-30 pointer-events-none"
                    animate={{ top: ["0%", "100%", "0%"] }}
                    transition={{ duration: 2.4, repeat: Infinity, ease: "linear" }}
                  />
                )}

                {}
                {!isAnalyzing &&
                  visibleBoxes.map((box, idx) => {
                    const cfg = getStyleForType(box.type);
                    const isHovered = hoveredBoxIndex === idx;
                    const isSelected = selectedVehicleId === box.id;
                    const isSearchResultMatch = Boolean(searchQuery.trim());

                    return (
                      <motion.div
                        key={box.id}
                        initial={{ opacity: 0, scale: 0.95 }}
                        animate={{ opacity: 1, scale: 1 }}
                        transition={{ delay: idx * 0.015 }}
                        onClick={(e) => {
                          e.stopPropagation();
                          focusVehicleOnImage(box);
                        }}
                        onMouseEnter={() => setHoveredBoxIndex(idx)}
                        onMouseLeave={() => setHoveredBoxIndex(null)}
                        className={`absolute border-2 ${cfg.border} ${cfg.bg} cursor-pointer z-20 group transition-all ${
                          isSelected
                            ? "ring-4 ring-yellow-400 border-yellow-300 shadow-[0_0_25px_rgba(250,204,21,0.8)]"
                            : isSearchResultMatch
                            ? "ring-2 ring-sky-400 shadow-[0_0_15px_rgba(56,189,248,0.7)]"
                            : cfg.shadow
                        }`}
                        style={{
                          top: `${box.top}%`,
                          left: `${box.left}%`,
                          width: `${box.width}%`,
                          height: `${box.height}%`,
                        }}
                      >
                        {/* Corner Reticles */}
                        <div className={`absolute top-0 left-0 w-1.5 h-1.5 border-t-2 border-l-2 ${isSelected ? "border-yellow-300" : cfg.border}`} />
                        <div className={`absolute top-0 right-0 w-1.5 h-1.5 border-t-2 border-r-2 ${isSelected ? "border-yellow-300" : cfg.border}`} />
                        <div className={`absolute bottom-0 left-0 w-1.5 h-1.5 border-b-2 border-l-2 ${isSelected ? "border-yellow-300" : cfg.border}`} />
                        <div className={`absolute bottom-0 right-0 w-1.5 h-1.5 border-b-2 border-r-2 ${isSelected ? "border-yellow-300" : cfg.border}`} />

                        {/* Informational Top Badge */}
                        <div
                          className={`absolute -top-6 left-0 ${isSelected ? "bg-yellow-400 text-slate-950 font-black" : cfg.badge} text-[9px] px-1.5 py-0.5 rounded shadow-md tracking-tight flex items-center gap-1 z-30 whitespace-nowrap transition-opacity ${
                            isHovered || isSelected ? "opacity-100 scale-105" : "opacity-90"
                          }`}
                        >
                          <span className="font-mono">#{box.index}</span>
                          <span>{box.subType || box.label}</span>
                          <span className="opacity-80 font-mono text-[8px]">{box.confidence}%</span>
                        </div>

                        {/* License Plate Indicator Overlay on Vehicle */}
                        {box.plateDetected && (
                          <div className="absolute bottom-1 right-1 flex items-center gap-1 bg-slate-950/90 border border-amber-400/90 text-amber-300 text-[8px] font-mono px-1 py-0.5 rounded shadow-lg">
                            <CreditCard className="w-2.5 h-2.5 text-amber-400" />
                            <span className="font-bold">{box.plateNumber}</span>
                          </div>
                        )}
                      </motion.div>
                    );
                  })}

                {/* Explicit License Plate Sub-Bounding Box Highlights */}
                {!isAnalyzing &&
                  visibleBoxes.map((box) => {
                    if (!box.plateBox) return null;
                    return (
                      <div
                        key={`plate-${box.id}`}
                        title={`License Plate: ${box.plateNumber}`}
                        className="absolute border border-yellow-400 bg-yellow-400/20 shadow-[0_0_8px_rgba(250,204,21,0.9)] z-25 pointer-events-none"
                        style={{
                          top: `${box.plateBox.top}%`,
                          left: `${box.plateBox.left}%`,
                          width: `${box.plateBox.width}%`,
                          height: `${box.plateBox.height}%`,
                        }}
                      />
                    );
                  })}
              </div>
            </div>
          )}
        </div>

        {}
        {fileType === "video" && mediaUrl && (
          <div className="mt-3 p-3 rounded-xl bg-slate-900/90 border border-slate-800 flex items-center gap-4">
            <button
              onClick={togglePlayVideo}
              className="p-2 rounded-lg bg-sky-500 hover:bg-sky-400 text-slate-950 font-bold transition-colors shadow"
              title={isVideoPlaying ? "Pause Video" : "Play Video"}
            >
              {isVideoPlaying ? <Pause className="w-4 h-4" /> : <Play className="w-4 h-4 ml-0.5" />}
            </button>

            <span className="text-xs font-mono text-slate-400 min-w-[45px]">
              {videoCurrentTime.toFixed(1)}s
            </span>

            <input
              type="range"
              min="0"
              max={videoDuration || 100}
              step="0.05"
              value={videoCurrentTime}
              onChange={handleSeek}
              className="flex-1 h-1.5 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-sky-400"
            />

            <span className="text-xs font-mono text-slate-400 min-w-[45px]">
              {videoDuration.toFixed(1)}s
            </span>

            <button
              onClick={analyzeVisualField}
              disabled={isAnalyzing}
              className="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-sky-400 border border-sky-500/30 text-xs font-semibold flex items-center gap-1.5 transition-colors shrink-0"
            >
              <Crosshair className="w-3.5 h-3.5" />
              <span>Capture & Scan Frame</span>
            </button>
          </div>
        )}

        {/* Bottom Inspection Summary Footer */}
        {results && (
          <footer className="mt-3 py-2 px-4 rounded-xl bg-slate-900/50 border border-slate-800/80 flex flex-wrap items-center justify-between text-xs text-slate-400 gap-2">
            <div className="flex items-center gap-3">
              <span className="flex items-center gap-1.5 text-emerald-400 font-semibold">
                <CheckCircle2 className="w-3.5 h-3.5" /> Vehicle & ANPR Complete
              </span>
              <span className="hidden sm:inline text-slate-600">|</span>
              <span className="truncate">{results.notes}</span>
            </div>
            <span className="font-mono text-[11px] text-slate-400">
              Scanned at {results.timestamp}
            </span>
          </footer>
        )}
      </main>
    </div>
  );
}
